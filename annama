<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>A Little Game for Annama</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f8c8dc, #e6e6fa, #ffffff);
            color: #333;
            overflow-x: hidden;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .scene {
            display: none;
            width: 100%;
            max-width: 400px;
            padding: 20px;
            text-align: center;
            background: rgba(255, 255, 255, 0.9);
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: all 0.5s ease;
        }
        .scene.active {
            display: block;
        }
        button {
            background: linear-gradient(135deg, #ff69b4, #dda0dd);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 25px;
            font-size: 16px;
            cursor: pointer;
            transition: transform 0.2s;
        }
        button:hover {
            transform: scale(1.05);
        }
        .heart {
            position: absolute;
            font-size: 30px;
            color: #ff69b4;
            animation: fall 3s linear infinite;
        }
        @keyframes fall {
            from { top: -50px; }
            to { top: 100vh; }
        }
        .puzzle-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 5px;
            width: 300px;
            height: 300px;
            margin: 0 auto;
        }
        .puzzle-tile {
            background-size: cover;
            cursor: pointer;
            border: 1px solid #ddd;
        }
        .memory-cards {
            display: flex;
            justify-content: space-around;
            flex-wrap: wrap;
        }
        .card {
            width: 80px;
            height: 80px;
            background: #dda0dd;
            border-radius: 10px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: transform 0.3s;
        }
        .card.flipped {
            transform: rotateY(180deg);
        }
        .starry {
            background: #000;
            position: relative;
            overflow: hidden;
        }
        .star {
            position: absolute;
            background: white;
            border-radius: 50%;
            animation: twinkle 2s infinite;
        }
        @keyframes twinkle {
            0%, 100% { opacity: 0; }
            50% { opacity: 1; }
        }
        .hold-button {
            width: 100px;
            height: 100px;
            background: #ff69b4;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            cursor: pointer;
            user-select: none;
        }
        .hold-button.holding {
            background: #dda0dd;
            transform: scale(1.1);
        }
        audio {
            display: none;
        }
    </style>
</head>
<body>
    <audio id="bg-music" loop>
        <source src="https://www.soundjay.com/misc/sounds/bell-ringing-05.wav" type="audio/wav"> <!-- Placeholder soft music; replace with actual URL -->
    </audio>

    <div id="intro" class="scene active">
        <h1>Hey Annama 👋</h1>
        <p>I made a little something for you. It’s a game 😏</p>
        <button onclick="nextScene('catch-hearts')">Start</button>
    </div>

    <div id="catch-hearts" class="scene">
        <h2>Catch the Hearts</h2>
        <p>Catch 5 hearts!</p>
        <div id="game-area" style="position: relative; height: 400px; overflow: hidden;"></div>
        <p id="score">Caught: 0</p>
    </div>

    <div id="pick-one" class="scene">
        <h2>Pick One</h2>
        <p>Who’s the cutest?</p>
        <button onclick="nextScene('puzzle')">me</button>
        <button onclick="alert('Wrong!')">you</button>
    </div>

    <div id="puzzle" class="scene">
        <h2>Sliding Puzzle</h2>
        <div class="puzzle-grid" id="puzzle-grid">
            <!-- Tiles will be generated by JS -->
        </div>
    </div>

    <div id="memory" class="scene">
        <h2>Memory Game</h2>
        <div class="memory-cards" id="memory-cards">
            <div class="card" onclick="flipCard(this, 0)">?</div>
            <div class="card" onclick="flipCard(this, 1)">?</div>
            <div class="card" onclick="flipCard(this, 2)">?</div>
            <div class="card" onclick="flipCard(this, 3)">?</div>
        </div>
    </div>

    <div id="starry" class="scene starry">
        <h2>You’re my favorite star in every sky.</h2>
        <button onclick="nextScene('final')">Next</button>
    </div>

    <div id="final" class="scene">
        <h2>Hold to Unlock</h2>
        <div class="hold-button" id="hold-btn" onmousedown="startHold()" onmouseup="endHold()" ontouchstart="startHold()" ontouchend="endHold()">❤️</div>
        <p id="final-msg" style="display: none;">You won the game 🥇 But the real prize was me all along 😌💘 I love you, Annama.</p>
    </div>

    <script>
        let currentScene = 'intro';
        let heartsCaught = 0;
        let holdTimer;
        let stars = [];
        const notes = ["You're amazing", "I love your smile", "Forever yours", "My heart"];

        function nextScene(sceneId) {
            document.getElementById(currentScene).classList.remove('active');
            document.getElementById(sceneId).classList.add('active');
            currentScene = sceneId;
            if (sceneId === 'catch-hearts') startCatchHearts();
            if (sceneId === 'puzzle') initPuzzle();
            if (sceneId === 'memory') initMemory();
            if (sceneId === 'starry') createStars();
        }

        function startCatchHearts() {
            heartsCaught = 0;
            document.getElementById('score').textContent = 'Caught: 0';
            const gameArea = document.getElementById('game-area');
            gameArea.innerHTML = '';
            for (let i = 0; i < 10; i++) {
                setTimeout(() => {
                    const heart = document.createElement('div');
                    heart.className = 'heart';
                    heart.textContent = '❤️';
                    heart.style.left = Math.random() * 80 + '%';
                    heart.addEventListener('click', () => {
                        heart.remove();
                        heartsCaught++;
                        document.getElementById('score').textContent = 'Caught: ' + heartsCaught;
                        if (heartsCaught >= 5) {
                            setTimeout(() => {
                                alert('You caught all my love ❤️');
                                nextScene('pick-one');
                            }, 500);
                        }
                    });
                    gameArea.appendChild(heart);
                }, i * 500);
            }
        }

        function initPuzzle() {
            const grid = document.getElementById('puzzle-grid');
            grid.innerHTML = '';
            const imageUrl = 'photo6.jpg'; // Replace with actual image URL
            const tiles = [];
            for (let i = 0; i < 9; i++) {
                const tile = document.createElement('div');
                tile.className = 'puzzle-tile';
                tile.style.backgroundImage = `url(${imageUrl})`;
                tile.style.backgroundPosition = `-${(i % 3) * 100}px -${Math.floor(i / 3) * 100}px`;
                tile.dataset.index = i;
                tile.addEventListener('click', () => moveTile(tile));
                tiles.push(tile);
                grid.appendChild(tile);
            }
            tiles[8].style.backgroundImage = 'none'; // Empty tile
            shuffleTiles(tiles);
        }

        function shuffleTiles(tiles) {
            for (let i = tiles.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [tiles[i], tiles[j]] = [tiles[j], tiles[i]];
            }
            tiles.forEach((tile, idx) => tile.dataset.index = idx);
        }

        function moveTile(tile) {
            const emptyTile = document.querySelector('.puzzle-tile[style*="none"]');
            if (isAdjacent(tile, emptyTile)) {
                [tile.dataset.index, emptyTile.dataset.index] = [emptyTile.dataset.index, tile.dataset.index];
                [tile.style.order, emptyTile.style.order] = [emptyTile.style.order, tile.style.order];
                if (isSolved()) {
                    alert('We fit perfectly too 😉');
                    nextScene('memory');
                }
            }
        }

        function isAdjacent(a, b) {
            const aIdx = parseInt(a.dataset.index);
            const bIdx = parseInt(b.dataset.index);
            const diff = Math.abs(aIdx - bIdx);
            return diff === 1 || diff === 3;
        }

        function isSolved() {
            const tiles = Array.from(document.querySelectorAll('.puzzle-tile'));
            return tiles.every((tile, idx) => parseInt(tile.dataset.index) === idx);
        }

        function initMemory() {
            // Cards are already in HTML
        }

        function flipCard(card, index) {
            card.classList.add('flipped');
            card.textContent = notes[index];
            setTimeout(() => {
                card.classList.remove('flipped');
                card.textContent = '?';
                if (document.querySelectorAll('.flipped').length === 4) {
                    nextScene('starry');
                }
            }, 2000);
        }

        function createStars() {
            const starry = document.getElementById('starry');
            for (let i = 0; i < 50; i++) {
                const star = document.createElement('div');
                star.className = 'star';
                star.style.width = Math.random() * 3 + 'px';
                star.style.height = star.style.width;
                star.style.left = Math.random() * 100 + '%';
                star.style.top = Math.random() * 100 + '%';
                star.style.animationDelay = Math.random() * 2 + 's';
                starry.appendChild(star);
            }
        }

        function startHold() {
            document.getElementById('hold-btn').classList.add('holding');
            holdTimer = setTimeout(() => {
                document.getElementById('final-msg').style.display = 'block';
                document.getElementById('hold-btn').style.display = 'none';
            }, 3000);
        }

        function endHold() {
            document.getElementById('hold-btn').classList.remove('holding');
            clearTimeout(holdTimer);
        }

        // Optional: Play music
        document.addEventListener('click', () => {
            document.getElementById('bg-music').play();
        });
    </script>
</body>
</html>
```
